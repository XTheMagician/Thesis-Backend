# Copy to .env and fill in the real values
OPENAI_API_KEY=sk-REPLACE_ME

# Optional overrides
# OPENAI_REALTIME_MODEL=gpt-realtime
# PORT=3000
# TICKET_INTERVAL_MS=8000

# Log the participant's transcribed speech TEXT in the JSONL log.
# Default false: only the timing of participant utterances is recorded
# (user:utterance events), never what they said. Robot speech is always logged.
# LOG_USER_TRANSCRIPT_TEXT=false
